{
  "mcpServers": {
    "codex-hud": {
      "command": "node",
      "args": ["./hud.mjs"],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "CODEX_HOME",
        "XDG_CONFIG_HOME",
        "CODEX_HUD_CONFIG",
        "CODEX_HUD_DISABLE"
      ],
      "startup_timeout_sec": 10
    }
  }
}
